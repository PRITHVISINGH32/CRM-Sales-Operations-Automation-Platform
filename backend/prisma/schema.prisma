generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANISER
  ADMIN
}

enum EventType {
  MOVIE
  CONCERT
}

enum ShowStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum OfferStatus {
  PENDING
  CLAIMED
  EXPIRED
}

model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  passwordHash    String
  role            Role            @default(CUSTOMER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  events          Event[]
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  createdVenues   Venue[]
}

model Venue {
  id            String         @id @default(uuid())
  name          String
  location      String
  createdBy     String?
  createdByUser User?          @relation(fields: [createdBy], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categories    SeatCategory[]
  seats         Seat[]
  shows         Show[]
}

model SeatCategory {
  id              String              @id @default(uuid())
  venueId         String
  venue           Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name            String
  seats           Seat[]
  showPrices      ShowCategoryPrice[]
  showSeats       ShowSeat[]
  waitlistEntries WaitlistEntry[]
}

model Seat {
  id         String       @id @default(uuid())
  venueId    String
  venue      Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  categoryId String
  category   SeatCategory @relation(fields: [categoryId], references: [id])
  rowLabel   String
  seatNumber Int
  position   Int          @default(0)
  showSeats  ShowSeat[]
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String
  type        EventType
  posterUrl   String?
  organiserId String
  organiser   User      @relation(fields: [organiserId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shows       Show[]
}

model Show {
  id             String              @id @default(uuid())
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueId        String
  venue          Venue               @relation(fields: [venueId], references: [id])
  startTime      DateTime
  endTime        DateTime
  status         ShowStatus          @default(ACTIVE)
  createdAt      DateTime            @default(now())
  categoryPrices ShowCategoryPrice[]
  showSeats      ShowSeat[]
  bookings       Booking[]
  waitlistEntries WaitlistEntry[]
}

model ShowCategoryPrice {
  id         String       @id @default(uuid())
  showId     String
  show       Show         @relation(fields: [showId], references: [id], onDelete: Cascade)
  categoryId String
  category   SeatCategory @relation(fields: [categoryId], references: [id])
  price      Float

  @@unique([showId, categoryId])
}

model ShowSeat {
  id            String         @id @default(uuid())
  showId        String
  show          Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  seatId        String
  seat          Seat           @relation(fields: [seatId], references: [id])
  categoryId    String
  category      SeatCategory   @relation(fields: [categoryId], references: [id])
  status        SeatStatus     @default(AVAILABLE)
  holdToken     String?
  holdExpiresAt DateTime?
  bookingId     String?
  booking       Booking?       @relation(fields: [bookingId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookingSeats  BookingSeat[]
  waitlistOffers WaitlistOffer[]

  @@unique([showId, seatId])
  @@index([showId, status])
  @@index([holdExpiresAt])
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  showId           String
  show             Show          @relation(fields: [showId], references: [id])
  totalAmount      Float
  status           BookingStatus @default(CONFIRMED)
  paymentStatus    PaymentStatus @default(PENDING)
  qrCodeData       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  showSeats        ShowSeat[]
  bookingSeats     BookingSeat[]

  @@index([userId])
  @@index([showId])
}

model BookingSeat {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showSeatId String
  showSeat   ShowSeat @relation(fields: [showSeatId], references: [id])
  price      Float
}

model WaitlistEntry {
  id         String         @id @default(uuid())
  showId     String
  show       Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  categoryId String
  category   SeatCategory   @relation(fields: [categoryId], references: [id])
  status     WaitlistStatus @default(WAITING)
  position   Int            @default(1)
  createdAt  DateTime       @default(now())
  offers     WaitlistOffer[]

  @@index([showId, categoryId, status, createdAt])
}

model WaitlistOffer {
  id              String        @id @default(uuid())
  waitlistEntryId String
  waitlistEntry   WaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)
  showSeatId      String
  showSeat        ShowSeat      @relation(fields: [showSeatId], references: [id])
  tokenHash       String
  expiresAt       DateTime
  status          OfferStatus   @default(PENDING)
  createdAt       DateTime      @default(now())

  @@index([expiresAt, status])
}
