# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticket_booking_db?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-change-in-production-2026

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# TTL Rules (Minutes)
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=10

# Resend Email Configuration
RESEND_API_KEY=re_123456789_example_key
EMAIL_FROM=onboarding@resend.dev
